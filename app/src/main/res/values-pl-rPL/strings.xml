    <string name="installer_session_title">Instalator sesji</string>
    <string name="installer_shizuku_desc">Używa systemowych API przez Shizuku\'s ADB lub usługę roota. Wymaga uruchomienia Shizuku lub Sui, z uprawnieniami przyznanymi ShizuStore.</string>
