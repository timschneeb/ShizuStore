  ~
  ~ Shizu Store's own launcher icon. Both layers are @mipmap PNGs because that is the only form
  ~ the artwork exists in.
  ~
  ~ No <monochrome> layer, deliberately: Android tints that layer flat, so it needs silhouette
  ~ artwork, and without the layer a themed launcher falls back to the full-colour icon.
  -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
